{
  "name": "sightline-desktop",
  "productName": "Sightline",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop wrapper for Sightline. On Windows it can run the scrim agent for you.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "gg.sightline.desktop",
    "productName": "Sightline",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js"],
    "extraResources": [
      {
        "from": "../agent",
        "to": "agent",
        "filter": ["**/*.mjs", "package.json", "!config.json", "!state.json"]
      }
    ],
    "win": { "target": "nsis", "icon": "icon.png" },
    "linux": { "target": ["AppImage", "deb"], "icon": "icon.png", "category": "Utility" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true }
  }
}
