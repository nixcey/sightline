{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "Sightline Scrim Importer",
    "author": "Sightline",
    "version": "1.0.0",
    "minimum-overwolf-version": "0.239.0",
    "description": "Auto-imports finished Valorant custom games into Sightline.",
    "icon": "icons/icon.png",
    "icon_gray": "icons/icon_gray.png"
  },
  "permissions": ["GameInfo"],
  "data": {
    "start_window": "background",
    "windows": {
      "background": {
        "file": "background.html",
        "is_background_page": true
      },
      "desktop": {
        "file": "desktop.html",
        "desc": "Sightline Scrim Importer",
        "size": { "width": 480, "height": 680 },
        "min_size": { "width": 420, "height": 520 },
        "show_in_taskbar": true,
        "resizable": true,
        "transparent": false,
        "native_window": true
      }
    },
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [21640]
    },
    "game_events": [21640],
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": { "game_ids": [21640] },
        "start_minimized": true
      }
    ]
  }
}
